{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cloudflare R2 Image Uploader",
  "version": "1.0.2",
  "identifier": "com.r2-image-uploader.desktop",
  "build": {
    "beforeDevCommand": "npm run vite:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run vite:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cloudflare R2 Image Uploader",
        "width": 800,
        "height": 650,
        "minWidth": 600,
        "minHeight": 500,
        "decorations": false,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
